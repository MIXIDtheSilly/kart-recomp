<?xml version="1.0" encoding="utf-8"?>
<!-- The translator's NuGet packages are in packages/ (Ryujinx.Common's four), so the build needs no package source:
     some machines have only "Microsoft Visual Studio Offline Packages" configured and could not restore them. -->
<configuration>
  <packageSources>
    <clear />
    <add key="kart-recomp" value="packages" />
  </packageSources>
</configuration>
