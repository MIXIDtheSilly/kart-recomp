<!-- The shader translator: the game's NVN2 (Ampere) shaders to SPIR-V, on Ryujinx's shader translator (../ryujinx).
     From plumber-racer-2's dm/gfx/tools/dmsh_xlate (MIT, see ../LICENSE-plumber-racer-2). tools/nvn_shaders.py builds it into
     work/xlate on first use. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ryujinx/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="../ryujinx/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
