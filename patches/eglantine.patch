+void HostMemory::MarkBackingFreed(size_t physical_offset, size_t length) {
+    if (!freed_pages || length == 0 || physical_offset >= backing_size) {
+        return;
+    }
+    const size_t first = physical_offset / BackingTrackPageSize;
+    const size_t last =
+        Common::DivCeil((std::min)(physical_offset + length, backing_size), BackingTrackPageSize);
+    for (size_t page = first; page < last;) {
+        const size_t bit = page % 64;
+        const size_t count = (std::min<size_t>)(64 - bit, last - page);
+        const u64 mask = (count == 64 ? ~u64{0} : ((u64{1} << count) - 1)) << bit;
+        freed_pages[page / 64].fetch_or(mask, std::memory_order_relaxed);
+        page += count;
+    }
 }
 
