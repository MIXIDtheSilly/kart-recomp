+
+template <class P>
+void BufferCache<P>::DumpUniformBind(size_t stage, u32 index, DAddr device_addr, u32 size) {
+    if (size == 0) {
+        return;
+    }
+    // Device addresses fit in 36 bits.
+    const u64 key = u64{stage} << 60 | u64{index} << 52 | device_addr;
+    UniformDumpEntry& entry = uniform_dump[key];
+    if (entry.binds++ == 0) {
+        device_memory.ReadBlockUnsafe(device_addr, entry.data.data(),
+                                      (std::min<u32>)(size, static_cast<u32>(entry.data.size())));
+    }
+}
+
+template <class P>
+void BufferCache<P>::LogUniformDump() {
+    std::vector<std::pair<u64, u64>> order; // (binds, key)
+    order.reserve(uniform_dump.size());
+    for (const auto& [key, entry] : uniform_dump) {
+        order.emplace_back(entry.binds, key);
+    }
+    const size_t count = (std::min<size_t>)(3, order.size());
+    std::partial_sort(order.begin(), order.begin() + count, order.end(), std::greater<>{});
+    for (size_t i = 0; i < count; ++i) {
+        const u64 key = order[i].second;
+        const UniformDumpEntry& entry = uniform_dump[key];
+        std::string hex;
+        hex.reserve(entry.data.size() * 2 + entry.data.size() / 4);
+        for (size_t offset = 0; offset < entry.data.size(); offset += 4) {
+            u32 word;
+            std::memcpy(&word, entry.data.data() + offset, 4);
+            hex += fmt::format("{:08x} ", word);
+        }
+        LOG_INFO(HW_GPU, "Uniform dump frame {} #{}: stage {} cbuf {} at {:#x}, {} binds: {}",
+                 uniform_dump_frame, i, key >> 60, (key >> 52) & 0xff, key & ((1ULL << 52) - 1),
+                 entry.binds, hex);
+    }
+    uniform_dump.clear();
+    ++uniform_dump_frame;
+}
