+template <class P>
+void BufferCache<P>::ScanUniform(size_t stage, u32 index, DAddr device_addr, u32 size) {
+    if (size == 0 || stage >= uniform_scan_last.size() || index >= uniform_scan_last[0].size() ||
+        uniform_scan_last[stage][index] == device_addr) {
+        return;
+    }
+    uniform_scan_last[stage][index] = device_addr;
+    ++uniform_scan_binds;
+    const u32 bytes = (std::min<u32>)(size, static_cast<u32>(uniform_scan_data.size())) & ~3U;
+    device_memory.ReadBlockUnsafe(device_addr, uniform_scan_data.data(), bytes);
+    u32 nonfinite = 0;
+    u32 huge = 0;
+    u32 first = ~0U;
+    for (u32 offset = 0; offset < bytes; offset += 4) {
+        u32 word;
+        std::memcpy(&word, uniform_scan_data.data() + offset, 4);
+        if ((word >> 16) == 0xffff) {
+            continue; // small negative integers
+        }
+        const u32 exponent = (word >> 23) & 0xff;
+        if (exponent == 0xff) {
+            ++nonfinite;
+        } else if (exponent >= 0xbc) { // |x| >= 2^61
+            ++huge;
+        } else {
+            continue;
+        }
+        first = (std::min)(first, offset);
+    }
+    if (nonfinite + huge == 0) {
+        return;
+    }
+    uniform_scan_nonfinite += nonfinite;
+    uniform_scan_huge += huge;
+    ++uniform_scan_bad_binds;
+    if (nonfinite + huge > uniform_scan_worst_count) {
+        uniform_scan_worst_count = nonfinite + huge;
+        uniform_scan_worst_addr = device_addr;
+        uniform_scan_worst_size = size;
+        uniform_scan_worst_offset = first;
+    }
+}
