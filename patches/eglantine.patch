+template <class P>
+void BufferCache<P>::CollectStaleBuffers() {
+    // Below the collector's 1 GiB mark, title 1 keeps every course's buffers: 0.46 -> 1.1 GiB of
+    // VRAM over three courses, most of it never bound again. Buffers unused for
+    // EDEN_NX2_BUFFER_STALE_AGE frames (default 600, 0 = off) go once the buffers total 384 MiB,
+    // up to 64 every 60 frames; only clean ones (GPU-written data would need a download first).
+    // They come back from guest memory if a draw uses them again.
+    static const u64 stale_age = [] {
+        const char* value = std::getenv("EDEN_NX2_BUFFER_STALE_AGE");
+        return value != nullptr ? std::strtoull(value, nullptr, 10) : 600ULL;
+    }();
+    if (stale_age == 0 || buffer_bytes < 384_MiB || frame_tick % 60 != 0 || frame_tick < stale_age) {
+        return;
+    }
+    boost::container::small_vector<BufferId, 64> stale;
+    lru_cache.ForEachItemBelow(frame_tick - stale_age, [&](BufferId buffer_id) {
+        if (stale.size() == 64) {
+            return true;
+        }
+        const Buffer& buffer = slot_buffers[buffer_id];
+        if (!gpu_modified_ranges.Intersects(buffer.CpuAddr(), buffer.SizeBytes())) {
+            stale.push_back(buffer_id);
+        }
+        return false;
+    });
+    for (const BufferId buffer_id : stale) {
+        stale_buffer_bytes += slot_buffers[buffer_id].SizeBytes();
+        DeleteBuffer(buffer_id);
+    }
+    stale_buffer_deletes += stale.size();
+}
