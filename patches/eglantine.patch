+namespace {
+// EDEN_NX2_GPU_WRITTEN_COMMANDS: 0 = read command lists on GPU-written pages unflushed (old),
+// drain = always drain and flush them (no copies), stats = drain and count the lists whose words
+// the flush changed (log every 10 s). Default 1: copies (ReadGpuWrittenCommands), else drain.
+int GpuWrittenCommandsMode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_GPU_WRITTEN_COMMANDS");
+        if (value == nullptr) {
+            return 1;
+        }
+        return value[0] == '0' ? 0 : value[0] == 's' ? 2 : value[0] == 'd' ? 3 : 1;
+    }();
+    return mode;
+}
+} // Anonymous namespace
+
+namespace {
+// EDEN_NX2_GPU_WRITTEN_DUMP=1: the words of command lists on GPU-written pages (culling output):
+// each list address's words the first time, then which words changed since its last read, and
+// every 10 s how many lists and words were read. To tell whether the GPU writes whole command
+// streams or only arguments into a fixed layout.
+void Nx2DumpGpuWrittenList(GPUVAddr address, std::span<const CommandHeader> commands, u32 method,
+                           u32 method_count, u32 subchannel, bool non_incrementing) {
+    static const bool on = std::getenv("EDEN_NX2_GPU_WRITTEN_DUMP") != nullptr;
+    if (!on) {
+        return;
+    }
+    static std::mutex mutex;
+    static std::unordered_map<GPUVAddr, std::vector<u32>> last;
+    static u64 lists{}, words{}, changed_lists{}, changed_words{}, logged{};
+    static auto last_log = std::chrono::steady_clock::now();
+    std::scoped_lock lock{mutex};
+    std::vector<u32> now(commands.size());
+    std::memcpy(now.data(), commands.data(), now.size() * sizeof(u32));
+    ++lists;
+    words += now.size();
+    auto [it, fresh] = last.try_emplace(address, now);
+    if (fresh) {
+        if (logged++ < 600) {
+            LOG_INFO(HW_GPU, "GPU-written list {:#x} +{} words (pending method {:#x} x{} sub {}{}): {:08x}",
+                     address, now.size(), method, method_count, subchannel, non_incrementing ? " NI" : "",
+                     fmt::join(std::span{now}.first(std::min<size_t>(now.size(), 96)), " "));
+        }
+    } else {
+        std::string diff;
+        u32 n = 0;
+        const size_t common = std::min(now.size(), it->second.size());
+        for (size_t i = 0; i < common; ++i) {
+            if (now[i] != it->second[i]) {
+                if (n++ < 24) {
+                    diff += fmt::format(" [{}] {:08x}->{:08x}", i, it->second[i], now[i]);
+                }
+            }
+        }
+        if (n != 0 || now.size() != it->second.size()) {
+            ++changed_lists;
+            changed_words += n;
+            if (logged++ < 600) {
+                LOG_INFO(HW_GPU, "GPU-written list {:#x} +{} words (was {}): {} changed{}", address,
+                         now.size(), it->second.size(), n, diff);
+            }
+        }
+        it->second = std::move(now);
+    }
+    if (const auto t = std::chrono::steady_clock::now(); t - last_log >= std::chrono::seconds{10}) {
+        last_log = t;
+        LOG_INFO(HW_GPU, "GPU-written lists: {} read ({} words), {} changed ({} words), {} addresses",
+                 lists, words, changed_lists, changed_words, last.size());
+        lists = words = changed_lists = changed_words = 0;
+    }
+}
