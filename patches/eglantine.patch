+namespace fctx = boost::context::detail;
+
+namespace Core {
+
+struct AotThread {
+    Ctx ctx{};
+    fctx::fcontext_t guest{};  ///< suspended guest fiber
+    fctx::fcontext_t host{};   ///< RunThread caller to return to
+    void* stack{};
+    u64 thread_id{};
+    u64 entry_pc{};
+    HaltReason reason{};
+    u32 svc{};
+    bool trapped{};
+};
+
+} // namespace Core
+
+namespace {
+
+constexpr std::size_t GuestFiberStackSize = 16 * 1024 * 1024;
+constexpr u64 AddressSpaceSize = 1ULL << 39;
+
+struct LoadedModule {
+    const char* name;
+    u64 base;
+    u64 size;
+    const FnEntry* table;
+    std::size_t table_size;
+};
+
+Core::System* g_system{};
+Core::Memory::Memory* g_memory{};
+Common::PageTable* g_page_table{};
+Common::HostMemory* g_host_memory{};
+std::vector<LoadedModule> g_loaded;
+bool g_modules_ok = true;
+
+/// Guest thread whose fiber this host thread is currently running.
+thread_local Core::AotThread* g_running{};
+
+std::mutex g_threads_mutex;
+std::unordered_map<u64, std::unique_ptr<Core::AotThread>> g_threads;
+
+Core::AotThread* FindThread(u64 thread_id) {
+    std::scoped_lock lk{g_threads_mutex};
+    const auto it = g_threads.find(thread_id);
+    return it == g_threads.end() ? nullptr : it->second.get();
+}
+
+GuestFn FindGuestFn(u64 target) {
+    for (const auto& m : g_loaded) {
+        if (target - m.base < m.size) {
+            return lookup_fn(m.table, m.table_size, target - m.base);
+        }
+    }
+    return nullptr;
+}
+
+void SwitchToHost(Core::AotThread* t) {
+    const auto tr = fctx::jump_fcontext(t->host, nullptr);
+    t->host = tr.fctx;  // whichever RunThread resumed us
+}
+
+std::string DescribeAddress(u64 addr);
+
+/// Walk the guest frame-pointer chain ([fp] = caller fp, [fp + 8] = return address).
+/// Kept free of C++ objects so it can use SEH against corrupt frames.
+int WalkGuestFrames(u64 fp, u64* out, int max) {
+    int n = 0;
+    __try {
+        while (fp && !(fp & 7) && n < max) {
+            const u64* frame = static_cast<const u64*>(hp(fp));
+            out[n++] = frame[1];
+            if (frame[0] <= fp) {
+                break;  // frames grow towards higher addresses
+            }
+            fp = frame[0];
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+    }
+    return n;
+}
+
+[[noreturn]] void Fault(Ctx* c, const std::string& what) {
+    auto* t = static_cast<Core::AotThread*>(c->rt);
+    LOG_CRITICAL(Core_ARM, "AOT: thread {}: {} (sp={:#x} lr={})", t->thread_id, what, c->sp,
+                 DescribeAddress(c->x[30]));
+    u64 frames[24];
+    const int n = WalkGuestFrames(c->x[29], frames, 24);
+    for (int i = 0; i < n; i++) {
+        LOG_CRITICAL(Core_ARM, "AOT:   #{:<2} {}", i, DescribeAddress(frames[i]));
+    }
+    t->trapped = true;
+    for (;;) {
+        t->reason = Core::HaltReason::PrefetchAbort;
+        SwitchToHost(t);
+    }
+}
+
+std::string DescribeAddress(u64 addr) {
+    for (const auto& m : g_loaded) {
+        if (addr - m.base < m.size) {
+            return fmt::format("{:#x} ({}+{:#x})", addr, m.name, addr - m.base);
+        }
+    }
+    return fmt::format("{:#x}", addr);
+}
+
+void FiberEntry(fctx::transfer_t tr) {
+    auto* t = static_cast<Core::AotThread*>(tr.data);
+    t->host = tr.fctx;
+    call_indirect(&t->ctx, t->entry_pc);
+    // A thread's entry function returned: continue at its link register like `ret` would.
+    const u64 lr = t->ctx.x[30];
+    if (lr != 0) {
+        call_indirect(&t->ctx, lr);
+    }
+    Fault(&t->ctx, "guest thread entry returned");
+}
+
+/// Name of the host function at `rip` (for recompiled code, the guest function it was lifted from).
+std::string HostSymbol(u64 rip) {
+    static std::mutex dbghelp_mutex;  // dbghelp is single-threaded
+    std::scoped_lock lk{dbghelp_mutex};
+    static std::once_flag once;
+    std::call_once(once, [] { SymInitialize(GetCurrentProcess(), nullptr, TRUE); });
+    alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256]{};
+    auto* sym = reinterpret_cast<SYMBOL_INFO*>(buf);
+    sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+    sym->MaxNameLen = 255;
+    DWORD64 disp = 0;
+    if (SymFromAddr(GetCurrentProcess(), rip, &disp, sym)) {
+        return fmt::format("{}+{:#x}", sym->Name, disp);
+    }
+    return fmt::format("{:#x}", rip);
+}
+
+[[noreturn]] void GuestMemoryFault(Ctx* c) {
+    Fault(c, "guest memory fault");
+}
+
+/// The general-purpose register that addresses the memory operand of the x86 instruction at
+/// `code` and that can be moved without changing what the instruction does (it is not also a
+/// data operand), or -1. Recompiled code addresses guest memory as [membase + offset] through
+/// ordinary ModRM operands.
+int RedirectableAddressRegister(const u8* code) {
+    int i = 0;
+    bool vex = false;
+    u8 rex = 0;
+    for (;; i++) {
+        const u8 b = code[i];
+        if (b == 0xF0 || b == 0xF2 || b == 0xF3 || b == 0x66 || b == 0x67 || b == 0x2E ||
+            b == 0x3E || b == 0x26 || b == 0x36 || b == 0x64 || b == 0x65) {
+            continue;
+        }
+        break;
+    }
+    if ((code[i] & 0xF0) == 0x40) {
+        rex = code[i++];
+    }
+    u8 opcode{};
+    bool two_byte = false;
+    if (code[i] == 0xC5) {  // two-byte VEX: inverted R in bit 7, then the opcode
+        rex = (code[i + 1] & 0x80) ? 0 : 4;
+        opcode = code[i + 2];
+        i += 3;
+        vex = true;
+    } else if (code[i] == 0xC4) {  // three-byte VEX: inverted R, X, B in bits 7-5
+        const u8 b1 = code[i + 1];
+        rex = ((b1 & 0x80) ? 0 : 4) | ((b1 & 0x40) ? 0 : 2) | ((b1 & 0x20) ? 0 : 1);
+        opcode = code[i + 3];
+        i += 4;
+        vex = true;
+    } else if (code[i] == 0x62) {
+        return -1;  // EVEX: not emitted
+    } else if (code[i] == 0x0F) {
+        two_byte = true;
+        i++;
+        if (code[i] == 0x38 || code[i] == 0x3A) {
+            i++;
+        }
+        opcode = code[i++];
+    } else {
+        opcode = code[i++];
+        // String instructions and moffs moves address memory without a ModRM operand.
+        if ((opcode >= 0xA0 && opcode <= 0xA7) || (opcode >= 0xAA && opcode <= 0xAF)) {
+            return -1;
+        }
+    }
+    const u8 modrm = code[i];
+    const u32 mod = modrm >> 6;
+    const int reg = ((modrm >> 3) & 7) | ((rex & 4) << 1);
+    if (mod == 3) {
+        return -1;
+    }
+    int base = -1;
+    int index = -1;
+    u32 scale = 0;
+    if ((modrm & 7) == 4) {
+        const u8 sib = code[i + 1];
+        scale = sib >> 6;
+        index = ((sib >> 3) & 7) | ((rex & 2) << 2);
+        if (index == 4) {
+            index = -1;  // no index
+        }
+        base = (sib & 7) | ((rex & 1) << 3);
+        if ((sib & 7) == 5 && mod == 0) {
+            base = -1;  // disp32 only
+        }
+    } else if ((modrm & 7) == 5 && mod == 0) {
+        return -1;  // RIP-relative
+    } else {
+        base = (modrm & 7) | ((rex & 1) << 3);
+    }
+    // Registers the instruction reads or writes besides the address: the ModRM reg operand of
+    // non-vector forms, RAX for CMPXCHG, RCX for shifts by CL, all of RAX-RDX for CMPXCHG16B.
+    const auto conflicts = [&](int r) {
+        if (r < 0 || r == 4) {
+            return true;  // RSP
+        }
+        if (!vex && r == reg) {
+            return true;
+        }
+        if (two_byte && (opcode == 0xB0 || opcode == 0xB1) && r == 0) {
+            return true;
+        }
+        if (two_byte && opcode == 0xC7 && r <= 3) {
+            return true;
+        }
+        if (!two_byte && !vex && (opcode == 0xD2 || opcode == 0xD3) && r == 1) {
+            return true;
+        }
+        return false;
+    };
+    if (!conflicts(base)) {
+        return base;
+    }
+    if (scale == 0 && !conflicts(index)) {
+        return index;
+    }
+    return -1;
+}
+
+/// A write to a GPU-cached page being executed against the page's unprotected backing memory:
+/// the register that was moved there and by how much.
+thread_local int g_redirect_reg = -1;
+thread_local u64 g_redirect_delta{};
+
+LONG CALLBACK FastmemFaultHandler(EXCEPTION_POINTERS* ep) {
+    constexpr DWORD TrapFlag = 0x100;
+    if (ep->ExceptionRecord->ExceptionCode == EXCEPTION_SINGLE_STEP && g_redirect_reg >= 0) {
+        (&ep->ContextRecord->Rax)[g_redirect_reg] -= g_redirect_delta;
+        g_redirect_reg = -1;
+        ep->ContextRecord->EFlags &= ~TrapFlag;
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    if (ep->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || !g_membase) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const uintptr_t addr = ep->ExceptionRecord->ExceptionInformation[1];
+    if (addr < g_membase || addr - g_membase >= AddressSpaceSize) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    // Pages the GPU caches are protected in the arena; invalidating them lifts the protection,
+    // after which the faulting instruction is simply re-executed (the same scheme as NCE).
+    thread_local u64 last_page = ~0ULL;
+    thread_local int repeats = 0;
+    const u64 page = (addr - g_membase) & ~u64{0xFFF};
+    repeats = page == last_page ? repeats + 1 : 0;
+    last_page = page;
+    const auto type = g_page_table ? g_page_table->entries[page >> 12].Type() : Common::PageType::Unmapped;
+    const bool mapped = type != Common::PageType::Unmapped;
+    const bool is_write = ep->ExceptionRecord->ExceptionInformation[0] == 1;
+    // A write to a GPU-cached page: handle it like the JIT's slow path does. The caches are told
+    // about the write and pick it up later (NCE's InvalidateNCE instead downloads the GPU's data
+    // and waits for the GPU to idle on every such fault, which stalls rendering many times a
+    // frame), then the store itself goes to the page's unprotected backing memory: the register
+    // addressing it is moved there for this one instruction (trap flag) and moved back after.
+    // The protection stays the caches' business. A store may cross into the neighbouring page
+    // (one that starts on the page before faults at this page's first byte; up to 32 bytes):
+    // the moved register covers both only where the backing memory continues there (equal page
+    // table pointers, which are backing minus address). Otherwise, and for unusual instructions,
+    // the NCE path. That path waits for the GPU, so it must stay rare.
+    const u64 vaddr = addr - g_membase;
+    const u64 offset = vaddr & 0xFFF;
+    const u64 backing = g_page_table && type == Common::PageType::RasterizerCachedMemory
+                            ? g_page_table->entries[page >> 12].Pointer(true)
+                            : 0;
+    const auto continues = [&](u64 other) {
+        return other < AddressSpaceSize &&
+               g_page_table->entries[other >> 12].Type() != Common::PageType::Unmapped &&
+               g_page_table->entries[other >> 12].Pointer(true) == backing;
+    };
+    static std::atomic<u64> fallbacks{};
+    if (backing && is_write && g_memory && g_redirect_reg < 0 &&
+        (offset != 0 || continues(page - 0x1000)) &&
+        (offset <= 0x1000 - 32 || continues(page + 0x1000))) {
+        const int reg = RedirectableAddressRegister(reinterpret_cast<const u8*>(ep->ContextRecord->Rip));
+        static std::atomic<u64> redirected{};
+        static std::atomic<u32> declined{};
+        if (reg < 0 && declined.fetch_add(1, std::memory_order_relaxed) < 16) {
+            const u8* code = reinterpret_cast<const u8*>(ep->ContextRecord->Rip);
+            LOG_WARNING(Core_ARM, "AOT: cached-page store at {} not redirected: {:02x}", HostSymbol(ep->ContextRecord->Rip),
+                        fmt::join(code, code + 12, " "));
+        }
+        if (reg >= 0) {
+            if ((redirected.fetch_add(1, std::memory_order_relaxed) & 0xFFFFF) == 0) {
+                LOG_INFO(Core_ARM, "AOT: {} stores to GPU-cached pages redirected, {} declined, {} slow",
+                         redirected.load() , declined.load(), fallbacks.load());
+            }
+            // The access size is unknown; 32 bytes covers every store the recompiled code emits
+            // and the dirty tracking works in 64-byte units anyway.
+            g_memory->RasterizerNotifyWrite(vaddr, offset > 0x1000 - 32 ? 0x1000 - offset : 32);
+            if (offset > 0x1000 - 32 &&
+                g_page_table->entries[(page >> 12) + 1].Type() == Common::PageType::RasterizerCachedMemory) {
+                g_memory->RasterizerNotifyWrite(page + 0x1000, offset - (0x1000 - 32));
+            }
+            g_redirect_reg = reg;
+            g_redirect_delta = backing + vaddr - addr;
+            (&ep->ContextRecord->Rax)[reg] += g_redirect_delta;
+            ep->ContextRecord->EFlags |= TrapFlag;
+            repeats = 0;
+            last_page = ~0ULL;
+            return EXCEPTION_CONTINUE_EXECUTION;
+        }
+    }
+    // A read of a GPU-cached page: only read traps (GPU-written buffer pages, armed until the
+    // CPU's first read) take read access away under AOT. Flush the GPU's data and disarm the trap
+    // as the JIT's slow read does, then re-execute the load.
+    if (backing && !is_write && g_memory && repeats < 4) {
+        static std::atomic<u64> read_faults{};
+        if (const u64 n = read_faults.fetch_add(1, std::memory_order_relaxed) + 1; (n & (n - 1)) == 0) {
+            LOG_INFO(Core_ARM, "AOT: {} reads of read-trapped GPU pages (latest {:#x} in {})", n,
+                     page, HostSymbol(ep->ContextRecord->Rip));
+        }
+        g_memory->RasterizerReadFault(page);
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    // GPU-cached pages: InvalidateNCE tells the caches about the access; the protection is
+    // lifted once they let go of the page, which may take a moment, so keep retrying (like NCE).
+    if (backing && is_write && repeats == 0 &&
+        (fallbacks.fetch_add(1, std::memory_order_relaxed) & 0xFFF) == 0) {
+        LOG_INFO(Core_ARM, "AOT: {} stores to GPU-cached pages took the slow path (latest at offset {:#x})",
+                 fallbacks.load(), offset);
+    }
+    if (mapped && repeats < 2048 && g_memory && g_memory->InvalidateNCE(page, 0x1000)) {
+        if (repeats >= 16) {
+            SwitchToThread();
+        }
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    if (mapped && g_host_memory) {
+        // Still refused: either the guest's own page permissions (which the interpreter/JIT paths
+        // ignore, reading through the page table) or a cache that never released the page.
+        // Behave like those paths and open it.
+        static std::atomic<u32> reported{};
+        if (reported.fetch_add(1, std::memory_order_relaxed) < 32) {
+            LOG_WARNING(Core_ARM, "AOT: opening protected guest page {:#x} (type {}) for {}", page,
+                        static_cast<int>(type), HostSymbol(ep->ContextRecord->Rip));
+        }
+        g_host_memory->Protect(page, 0x1000, Common::MemoryPermission::ReadWrite);
+        repeats = 0;
+        last_page = ~0ULL;
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    MEMORY_BASIC_INFORMATION mbi{};
+    VirtualQuery(reinterpret_cast<void*>(g_membase + page), &mbi, sizeof(mbi));
+    LOG_CRITICAL(Core_ARM,
+                 "AOT: unhandled guest memory fault at {:#x} ({} access) in {} (page type {}, "
+                 "arena state {:#x} protect {:#x})",
+                 addr - g_membase, ep->ExceptionRecord->ExceptionInformation[0] ? "write" : "read",
+                 HostSymbol(ep->ContextRecord->Rip), static_cast<int>(type), mbi.State, mbi.Protect);
+    Core::AotThread* t = g_running;
+    if (!t) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    for (int i = 0; i < 32; i += 4) {
+        LOG_CRITICAL(Core_ARM, "AOT:   x{:<2} {:016x} {:016x} {:016x} {:016x}", i, t->ctx.x[i],
+                     t->ctx.x[i + 1], t->ctx.x[i + 2], i + 3 < 31 ? t->ctx.x[i + 3] : t->ctx.sp);
+    }
+    // Stop only this guest thread: resume the host thread in GuestMemoryFault on a fresh frame.
+    auto& r = *ep->ContextRecord;
+    r.Rsp = ((r.Rsp - 512) & ~u64{15}) - 8;
+    r.Rcx = reinterpret_cast<DWORD64>(&t->ctx);
+    r.Rip = reinterpret_cast<DWORD64>(&GuestMemoryFault);
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+} // namespace
+
+// ------------------------------------------------------------------ runtime entry points used by recompiled code
+
+uintptr_t g_membase = 0;
+
+GuestFn lookup_fn(const FnEntry* table, size_t size, uint64_t addr) {
+    size_t lo = 0, hi = size;
+    while (lo < hi) {
+        const size_t mid = (lo + hi) / 2;
+        if (table[mid].addr < addr) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    return lo < size && table[lo].addr == addr ? table[lo].fn : nullptr;
+}
+
+// ---- NVN call tracer (EDEN_AOT_NVN_TRACE=<out file>, EDEN_AOT_NVN_PROCS=<"offset name" list>):
+// logs every indirect call into the sdk's NVN entry points with arguments, x0 on return and the
+// first bytes behind pointer arguments. Used as the reference for the standalone NVN.
+namespace {
+
+bool SafeCopyGuest(void* dst, u64 addr, size_t n) {
+    // The fastmem fault handler would treat a fault here as a guest crash: check the page table.
+    if (addr < 0x1000 || addr >= AddressSpaceSize - n || !g_memory->IsValidVirtualAddressRange(addr, n)) {
+        return false;
+    }
+    std::memcpy(dst, hp(addr), n);
+    return true;
+}
+
+struct NvnTracer {
+    std::FILE* out{};
+    std::unordered_map<u64, std::string> names;  // guest address -> name
+    u64 lo = ~0ULL, hi = 0;
+    std::mutex lock;
+    std::unordered_map<std::string, u64> counts;
+    u64 lines = 0, limit = 2'000'000;
+    std::atomic<u64> seq{0};
+
+    NvnTracer() {
+        const char* path = std::getenv("EDEN_AOT_NVN_TRACE");
+        const char* procs = std::getenv("EDEN_AOT_NVN_PROCS");
+        if (!path || !procs) {
+            return;
+        }
+        u64 sdk = 0;
+        for (const auto& m : g_loaded) {
+            if (std::strcmp(m.name, "sdk") == 0) {
+                sdk = m.base;
+            }
+        }
+        std::FILE* f = std::fopen(procs, "r");
+        if (!f || !sdk) {
+            return;
+        }
+        char name[256];
+        unsigned long long off;
+        while (std::fscanf(f, "%llx %255s", &off, name) == 2) {
+            names[sdk + off] = name;
+            lo = std::min<u64>(lo, sdk + off);
+            hi = std::max<u64>(hi, sdk + off);
+        }
+        std::fclose(f);
+        if (const char* l = std::getenv("EDEN_AOT_NVN_TRACE_LIMIT")) {
+            limit = std::strtoull(l, nullptr, 0);
+        }
+        out = std::fopen(path, "w");
+        LOG_INFO(Core_ARM, "AOT: tracing {} NVN entry points to {}", names.size(), path);
+    }
+
+    static std::string Bytes(u64 addr, size_t n) {
+        u8 buf[64];
+        if (!SafeCopyGuest(buf, addr, n)) {
+            return {};
+        }
+        std::string s = " [";
+        for (size_t i = 0; i < n; i += 4) {
+            u32 w;
+            std::memcpy(&w, buf + i, 4);
+            s += fmt::format("{}{:08x}", i ? " " : "", w);
+        }
+        return s + "]";
+    }
+
+    void Call(Ctx* c, u64 target, GuestFn fn) {
+        const auto it = names.find(target);
+        const auto* t = static_cast<Core::AotThread*>(c->rt);
+        u64 a[8];
+        std::memcpy(a, c->x, sizeof(a));
+        const u64 lr = c->x[30];
+        const u64 n = seq++;
+        fn(c);
+        std::scoped_lock lk{lock};
+        counts[it->second]++;
+        if (lines >= limit) {
+            return;
+        }
+        lines++;
+        std::string line = fmt::format("{} t{} {}({:#x}, {:#x}, {:#x}, {:#x}, {:#x}, {:#x}) = {:#x} from {}", n,
+                                       t ? t->thread_id : 0, it->second, a[0], a[1], a[2], a[3], a[4], a[5],
+                                       c->x[0], DescribeAddress(lr));
+        // Contents behind pointer-like arguments after the call (out parameters, builders, structs).
+        for (int i = 0; i < 4; i++) {
+            if (a[i] > 0x10000000 && a[i] < AddressSpaceSize) {
+                const std::string b = Bytes(a[i], 32);
+                if (!b.empty()) {
+                    line += fmt::format(" x{}{}", i, b);
+                }
+            }
+        }
+        std::fprintf(out, "%s\n", line.c_str());
+        if ((lines & 0xfff) == 0 || lines == limit) {
+            std::fflush(out);
+        }
+        if (lines == limit) {
+            std::vector<std::pair<u64, std::string>> v;
+            for (auto& [k, cnt] : counts) {
+                v.emplace_back(cnt, k);
+            }
+            std::sort(v.rbegin(), v.rend());
+            for (auto& [cnt, k] : v) {
+                std::fprintf(out, "count %llu %s\n", static_cast<unsigned long long>(cnt), k.c_str());
+            }
+            std::fflush(out);
+        }
+    }
+};
+
+NvnTracer& Tracer() {
+    static NvnTracer t;
+    return t;
+}
+
+} // namespace
+
+void call_indirect(Ctx* c, uint64_t target) {
+    struct Entry {
+        u64 addr;
+        GuestFn fn;
+    };
+    thread_local Entry cache[4096]{};
+    static NvnTracer& tracer = Tracer();
+    Entry& e = cache[(target >> 2) & 4095];
+    if (e.addr != target || !e.fn) {
+        GuestFn fn = FindGuestFn(target);
+        if (!fn) {
+            Fault(c, "indirect branch to code that was not recompiled: " + DescribeAddress(target));
+        }
+        e = {target, fn};
+    }
+    if (tracer.out && target - tracer.lo <= tracer.hi - tracer.lo && tracer.names.count(target)) {
+        tracer.Call(c, target, e.fn);
+        return;
+    }
+    e.fn(c);
+}
+
+void guest_svc(Ctx* c, uint32_t imm) {
+    auto* t = static_cast<Core::AotThread*>(c->rt);
+    t->svc = imm;
+    t->reason = Core::HaltReason::SupervisorCall;
+    SwitchToHost(t);
+}
+
+void guest_yield(Ctx* c) {
+    if (!c->halt) {
+        return;
+    }
+    c->halt = 0;
+    auto* t = static_cast<Core::AotThread*>(c->rt);
+    t->reason = Core::HaltReason::BreakLoop;
+    SwitchToHost(t);
+}
+
+void guest_trap(Ctx* c, uint64_t pc, uint32_t imm) {
+    Fault(c, fmt::format("trap {:#x} at {}", imm, DescribeAddress(pc)));
+}
+
+void guest_unresolved_jump(Ctx* c, uint64_t from, uint64_t target) {
+    Fault(c, fmt::format("jump table at {} reached unknown target {}", DescribeAddress(from),
+                         DescribeAddress(target)));
+}
+
+uint64_t host_cntvct() {
+    return g_system->CoreTiming().GetClockTicks();
+}
+
+uint64_t host_cntfrq() {
+    return 19'200'000;
+}
+
+static uint32_t crc32_bytes(uint32_t acc, uint64_t v, int bytes) {
+    for (int i = 0; i < bytes; i++) {
+        acc ^= static_cast<uint8_t>(v >> (8 * i));
+        for (int b = 0; b < 8; b++) {
+            acc = (acc >> 1) ^ (0xEDB88320u & (0u - (acc & 1)));
+        }
+    }
+    return acc;
+}
+uint32_t crc32_8(uint32_t a, uint64_t v) { return crc32_bytes(a, v, 1); }
+uint32_t crc32_16(uint32_t a, uint64_t v) { return crc32_bytes(a, v, 2); }
+uint32_t crc32_32(uint32_t a, uint64_t v) { return crc32_bytes(a, v, 4); }
+uint32_t crc32_64(uint32_t a, uint64_t v) { return crc32_bytes(a, v, 8); }
+
+// ------------------------------------------------------------------ backend
+
+namespace Core {
+
+bool AotEnabled() {
+    const char* v = std::getenv("EDEN_AOT");
+    return v && v[0] == '1';
+}
+
+void AotRegisterModule(std::string_view name, std::uint64_t base, std::uint64_t size,
+                       std::string_view module_id_hex) {
+    if (!AotEnabled()) {
+        return;
+    }
+    for (std::size_t i = 0; i < g_aot_module_count; i++) {
+        const AotModuleDesc& d = g_aot_modules[i];
+        if (name != d.name) {
+            continue;
+        }
+        if (module_id_hex != d.module_id) {
+            LOG_CRITICAL(Core_ARM, "AOT: module {} build id {} does not match the recompiled {}",
+                         name, module_id_hex, d.module_id);
+            g_modules_ok = false;
+            return;
+        }
+        *d.base = base;
+        g_loaded.push_back({d.name, base, size, d.table, aot_table_size(i)});
+        LOG_INFO(Core_ARM, "AOT: {} at {:#x} ({} recompiled functions)", name, base, aot_table_size(i));
+        return;
+    }
+    LOG_CRITICAL(Core_ARM, "AOT: module {} was not recompiled", name);
+    g_modules_ok = false;
+}
+
+ArmAot::ArmAot(System& system, Kernel::KProcess* process, std::size_t core_index)
+    : ArmInterface{true}, m_system{system}, m_process{process}, m_core_index{core_index} {}
+
+ArmAot::~ArmAot() = default;
+
+void ArmAot::Initialize() {
+    static std::once_flag once;
+    std::call_once(once, [this] {
+        g_system = &m_system;
+        g_memory = &m_process->GetMemory();
+        auto* arena = m_process->GetPageTable().GetBasePageTable().GetImpl().fastmem_arena;
+        g_membase = reinterpret_cast<uintptr_t>(arena);
+        g_page_table = &m_process->GetPageTable().GetBasePageTable().GetImpl();
+        g_host_memory = &m_system.DeviceMemory().buffer;        // Reactive flushing read-protects GPU-cached pages and relies on the interpreter/JIT slow
+        // path to download them on CPU reads. Recompiled code always takes the fastmem path, so
+        // only write-protect them (writes are reported to the caches by the fault handler).
+        if (Settings::values.use_reactive_flushing.GetValue()) {
+            LOG_WARNING(Core_ARM, "AOT: disabling reactive flushing (unsupported by recompiled code)");
+            Settings::values.use_reactive_flushing.SetValue(false);
+        }
+        if (!arena) {
+            LOG_CRITICAL(Core_ARM, "AOT: fastmem is disabled; recompiled code needs the fastmem arena");
+        }
+        if (!g_modules_ok) {
+            LOG_CRITICAL(Core_ARM, "AOT: module check failed, guest code will not run correctly");
+        }
+        AddVectoredExceptionHandler(1, FastmemFaultHandler);
+    });
+}
+
+AotThread* ArmAot::CurrentThread() const {
+    if (auto* kt = Kernel::GetCurrentThreadPointer(m_system.Kernel())) {
+        if (auto* t = FindThread(kt->GetThreadId())) {
+            return t;
+        }
+    }
+    return m_last;
+}
+
+HaltReason ArmAot::RunThread(Kernel::KThread* thread) {
+    AotThread* t = FindThread(thread->GetThreadId());
+    if (!t) {
+        auto fresh = std::make_unique<AotThread>();
+        t = fresh.get();
+        t->thread_id = thread->GetThreadId();
+        const auto& kc = thread->GetContext();
+        for (std::size_t i = 0; i < 29; i++) {
+            t->ctx.x[i] = kc.r[i];
+        }
+        t->ctx.x[29] = kc.fp;
+        t->ctx.x[30] = kc.lr;
+        t->ctx.sp = kc.sp;
+        std::memcpy(t->ctx.v, kc.v.data(), sizeof(t->ctx.v));
+        set_nzcv(&t->ctx, kc.pstate >> 28);
+        t->ctx.fpcr = kc.fpcr;
+        t->ctx.fpsr = kc.fpsr;
+        t->ctx.tpidr_el0 = kc.tpidr;
+        t->ctx.tpidrro_el0 = GetInteger(thread->GetTlsAddress());
+        t->ctx.excl_addr = ~0ULL;
+        t->ctx.rt = t;
+        t->entry_pc = kc.pc;
+        t->stack = VirtualAlloc(nullptr, GuestFiberStackSize, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        t->guest = fctx::make_fcontext(static_cast<u8*>(t->stack) + GuestFiberStackSize,
+                                       GuestFiberStackSize, FiberEntry);
+        LOG_INFO(Core_ARM, "AOT: thread {} starts at {}", t->thread_id, DescribeAddress(kc.pc));
+        std::scoped_lock lk{g_threads_mutex};
+        g_threads.emplace(t->thread_id, std::move(fresh));
+    }
+    m_last = t;
+    if (t->trapped) {
+        return HaltReason::PrefetchAbort;
+    }
+    t->reason = {};
+    g_running = t;
+    const auto tr = fctx::jump_fcontext(t->guest, t);
+    g_running = nullptr;
+    t->guest = tr.fctx;
+    return t->reason;
+}
+
+HaltReason ArmAot::StepThread(Kernel::KThread* thread) {
+    return HaltReason::StepThread;  // single-stepping recompiled code is not supported
+}
+
+void ArmAot::GetContext(Kernel::Svc::ThreadContext& kc) const {
+    const AotThread* t = CurrentThread();
+    if (!t) {
+        return;
+    }
+    for (std::size_t i = 0; i < 29; i++) {
+        kc.r[i] = t->ctx.x[i];
+    }
+    kc.fp = t->ctx.x[29];
+    kc.lr = t->ctx.x[30];
+    kc.sp = t->ctx.sp;
+    kc.pstate = static_cast<u32>(get_nzcv(const_cast<Ctx*>(&t->ctx)));
+    std::memcpy(kc.v.data(), t->ctx.v, sizeof(t->ctx.v));
+    kc.fpcr = static_cast<u32>(t->ctx.fpcr);
+    kc.fpsr = static_cast<u32>(t->ctx.fpsr);
+    kc.tpidr = t->ctx.tpidr_el0;
+    // kc.pc keeps its last value: recompiled code does not track the guest pc.
+}
+
+void ArmAot::SetContext(const Kernel::Svc::ThreadContext& ctx) {
+    // Running threads keep their state in their own AotThread; new threads read their initial
+    // context from the KThread on first run, so there is nothing to load here.
+}
+
+void ArmAot::SetTpidrroEl0(u64 value) {}
+
+void ArmAot::GetSvcArguments(std::span<uint64_t, 8> args) const {
+    const AotThread* t = CurrentThread();
+    for (std::size_t i = 0; i < 8; i++) {
+        args[i] = t->ctx.x[i];
+    }
+}
+
+void ArmAot::SetSvcArguments(std::span<const uint64_t, 8> args) {
+    AotThread* t = CurrentThread();
+    for (std::size_t i = 0; i < 8; i++) {
+        t->ctx.x[i] = args[i];
+    }
+}
+
+u32 ArmAot::GetSvcNumber() const {
+    const AotThread* t = CurrentThread();
+    return t ? t->svc : 0;
+}
+
+void ArmAot::SignalInterrupt(Kernel::KThread* thread) {
+    if (AotThread* t = FindThread(thread->GetThreadId())) {
+        t->ctx.halt = 1;
+    }
+}
+
+} // namespace Core
