+template <class P>
+void TextureCache<P>::CollectStaleImages() {
+    // Images whose guest memory the CPU has overwritten since their upload (and the GPU never
+    // wrote) come back from guest memory on their next use anyway, so keeping them buys nothing.
+    // The collector keeps them until VRAM is nearly full (decoded ASTC is CostlyLoad), and title 1
+    // loads each course's shared textures at new addresses: the old copies piled up as up to
+    // ~1.2 GB of duplicates and pushed VRAM over the budget at course loads, where Windows demotes
+    // memory to system RAM for good. EDEN_NX2_STALE_AGE=<frames unused> (0 = off).
+    static const u64 stale_age = [] {
+        const char* value = std::getenv("EDEN_NX2_STALE_AGE");
+        return value != nullptr ? std::strtoull(value, nullptr, 10) : 300ULL;
+    }();
+    if (stale_age == 0 || frame_tick % 30 != 0 || frame_tick < stale_age) {
+        return;
+    }
+    boost::container::small_vector<ImageId, 64> stale;
+    lru_cache.ForEachItemBelow(frame_tick - stale_age, [&](ImageId image_id) {
+        const auto& image = slot_images[image_id];
+        if (True(image.flags & ImageFlagBits::CpuModified) &&
+            False(image.flags & (ImageFlagBits::GpuModified | ImageFlagBits::IsDecoding))) {
+            stale.push_back(image_id);
+        }
+        return false;
+    });
+    for (const ImageId image_id : stale) {
+        auto& image = slot_images[image_id];
+        ++stale_deletes;
+        stale_deleted_bytes += GetScaledImageSizeBytes(image);
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+        UnregisterImage(image_id);
+        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+    }
+}
