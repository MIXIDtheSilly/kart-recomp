+template <class P>
+void BufferCache<P>::NoteSsboStats(GPUVAddr ssbo_addr, u32 cbuf_index, u32 cbuf_offset,
+                                   bool is_written, u32 binding_size) {
+    const GPUVAddr gpu_addr = gpu_memory->Read<u64>(ssbo_addr);
+    if (gpu_addr == 0) {
+        return;
+    }
+    const u64 next_qword = gpu_memory->Read<u64>(ssbo_addr + 8);
+    const u32 layout = static_cast<u32>(gpu_memory->GetMemoryLayoutSize(gpu_addr));
+    const u32 packed = static_cast<u32>(next_qword);
+    const bool sized = (next_qword >> 32) == 0 && packed != 0 && packed <= layout;
+    // EDEN_NX2_SSBO_WATCH=<lo>-<hi> (device addresses): log each distinct (program, slot, range)
+    // whose written binding overlaps that range.
+    static const std::pair<u64, u64> watch = [] {
+        const char* v = std::getenv("EDEN_NX2_SSBO_WATCH");
+        if (v == nullptr) {
+            return std::pair<u64, u64>{0, 0};
+        }
+        char* end = nullptr;
+        const u64 lo = std::strtoull(v, &end, 16);
+        const u64 hi = end != nullptr && *end == '-' ? std::strtoull(end + 1, nullptr, 16) : 0;
+        return std::pair<u64, u64>{lo, hi};
+    }();
+    if (watch.second != 0 && is_written) {
+        const auto device = gpu_memory->GpuToCpuAddress(gpu_addr);
+        const u64 size = sized ? packed : binding_size;
