+    }
+    FrameTraceRun* run = frame_trace_runs.empty() ? nullptr : &frame_trace_runs.back();
+    if (run == nullptr || run->compute != compute || run->color != key.color ||
+        run->depth != key.depth || run->width != key.width || run->format != key.format) {
+        key.big = key.width >= 640;
+        run = &frame_trace_runs.emplace_back(key);
+    }
+    ++run->draws;
+    ++frame_trace_draws;
+    // EDEN_NX2_FRAME_TRACE=2 also compares the first draws' constants frame to frame.
+    static const bool snapshots = [] {
+        const char* value = std::getenv("EDEN_NX2_FRAME_TRACE");
+        return value != nullptr && value[0] == '2';
+    }();
+    if (snapshots && !compute && run->big && run->draws <= 8 && !views.empty()) {
+        FrameTraceSnapshot(*run);
+    }
+    static const bool pass_log = std::getenv("EDEN_NX2_PASS_LOG") != nullptr;
+    if (!compute && run->big && (FrameDumpEnabled() || pass_log)) {
+        FrameDumpRecord(*run, views);
+    }
+    // EDEN_NX2_FRAME_LIST_EVERY=<n>: on every n-th frame from 6000 on, list each draw of the
+    // screen-sized passes: shaders, constant buffers (vertex-stage ones with their first words)
+    // and the first textures.
+    static const u64 list_every = [] {
+        const char* value = std::getenv("EDEN_NX2_FRAME_LIST_EVERY");
+        return value != nullptr ? std::strtoull(value, nullptr, 10) : 0ULL;
+    }();
+    if (list_every != 0 && !compute && run->big && frame_trace_frame >= 6000 &&
+        frame_trace_frame % list_every == 0) {
+        const auto& regs = maxwell3d->regs;
+        const u64 vs = (u64{regs.pipelines[1].reserved[0] & 0xff} << 32) | regs.pipelines[1].reserved[1];
+        const u64 ps = (u64{regs.pipelines[5].reserved[0] & 0xff} << 32) | regs.pipelines[5].reserved[1];
+        std::string text;
+        for (const u32 stage : {0u, 4u}) {
+            const auto& buffers = maxwell3d->state.shader_stages[stage].const_buffers;
+            for (u32 slot = 0; slot < buffers.size(); ++slot) {
+                const auto& buffer = buffers[slot];
+                if (!buffer.enabled || buffer.address == 0) {
+                    continue;
+                }
+                text += fmt::format(" {}c{}@{:#x}/{:#x}", stage == 0 ? "v" : "f", slot, buffer.address,
+                                    buffer.size);
+                if (stage == 0 && slot != 0) {
+                    std::array<f32, 16> words{};
+                    const size_t bytes = (std::min<size_t>)(buffer.size, sizeof(words));
+                    if (gpu_memory->IsFullyMappedRange(buffer.address, bytes)) {
+                        gpu_memory->ReadBlockUnsafe(buffer.address, words.data(), bytes);
+                    }
+                    text += "[";
+                    for (size_t i = 0; i < bytes / 4; ++i) {
+                        text += fmt::format("{}{:.4g}", i == 0 ? "" : " ", words[i]);
+                    }
+                    text += "]";
+                }
+            }
+        }
+        text += " tex";
+        size_t textures = 0;
+        for (const ImageViewInOut& view : views) {
+            if (!view.id || textures++ >= 4) {
+                continue;
+            }
+            const ImageViewBase& image_view = slot_image_views[view.id];
+            text += fmt::format(" {:#x}:{}x{}f{}", image_view.gpu_addr, image_view.size.width,
+                                image_view.size.height, static_cast<u32>(image_view.format));
+        }
+        LOG_INFO(HW_GPU, "Frame list {} pass {} {:#x}/{:#x} draw {}: vs {:#x} ps {:#x}{}",
+                 frame_trace_frame, frame_trace_runs.size() - 1, run->color, run->depth, run->draws,
+                 vs, ps, text);
+    }
+    if (run->overflow) {
+        return;
+    }
+    for (const ImageViewInOut& view : views) {
+        if (!view.id) {
+            continue;
+        }
+        const ImageViewBase& image_view = slot_image_views[view.id];
+        GPUVAddr address = image_view.gpu_addr;
+        u32 width = image_view.size.width;
+        if (image_view.image_id) {
+            const Image& image = slot_images[image_view.image_id];
+            address = image.gpu_addr;
+            width = image.info.size.width |
+                    (True(image.flags & ImageFlagBits::GpuModified) ? 1u << 31 : 0u);
+        }
+        if (compute && (width & 0x7fffffff) >= 640) {
+            run->big = true;
+        }
+        const auto it = std::ranges::find_if(run->textures,
+                                             [&](const auto& t) { return t.first == address; });
+        if (it != run->textures.end()) {
+            continue;
+        }
+        if (run->textures.size() == run->textures.capacity()) {
+            run->overflow = true;
+            return;
+        }
+        run->textures.emplace_back(address, width);
+    }
+}
+
+template <class P>
+void TextureCache<P>::FrameTraceSnapshot(FrameTraceRun& run) {
+    const auto add = [&](u32 stage, u32 slot, GPUVAddr address, u32 size) {
+        auto& snapshot = run.snapshots.emplace_back();
+        snapshot.draw = run.draws - 1;
+        snapshot.stage = stage;
+        snapshot.slot = slot;
+        snapshot.address = address;
+        snapshot.size = size;
+        snapshot.data.fill(0);
+        const size_t bytes = (std::min<size_t>)(size, sizeof(snapshot.data));
+        if (bytes != 0 && gpu_memory->IsFullyMappedRange(address, bytes)) {
+            gpu_memory->ReadBlockUnsafe(address, snapshot.data.data(), bytes);
+        }
+    };
+    for (const u32 stage : {0u, 4u}) {
+        const auto& buffers = maxwell3d->state.shader_stages[stage].const_buffers;
+        for (u32 slot = 0; slot < buffers.size(); ++slot) {
+            if (buffers[slot].enabled && buffers[slot].address != 0) {
+                add(stage, slot, buffers[slot].address, buffers[slot].size);
+            }
+        }
+    }
+    for (u32 stream = 0; stream < 2; ++stream) {
+        const auto& vertex_stream = maxwell3d->regs.vertex_streams[stream];
+        if (vertex_stream.IsEnabled()) {
+            add(255, stream, vertex_stream.Address(), 128);
+        }
+    }
+}
+
+// Words of the post passes' constants that held one value for a long time and change now:
+// logged with the old and new contents (the passes' varying words never are).
+template <class P>
+void TextureCache<P>::FrameTraceCompare() {
+    std::unordered_map<GPUVAddr, u32> occurrences;
+    u32 logged = 0;
+    for (const FrameTraceRun& run : frame_trace_runs) {
+        if (run.snapshots.empty()) {
+            continue;
+        }
+        const u32 occurrence = occurrences[run.color]++;
+        for (const auto& snapshot : run.snapshots) {
+            u64 key = 0xcbf29ce484222325ULL;
+            for (const u64 value : {u64{run.color}, u64{run.depth}, u64{occurrence}, u64{snapshot.draw},
+                                    u64{snapshot.stage}, u64{snapshot.slot}}) {
+                key = (key ^ value) * 0x100000001b3ULL;
+            }
+            const auto [it, is_new] = frame_trace_words.try_emplace(key);
+            FrameTraceWords& words = it->second;
+            if (is_new || words.last_frame + 1 != frame_trace_frame) {
+                // New, or the pass was missing last frame: start over.
+                words.data = snapshot.data;
+                words.stable.fill(0);
+                words.last_frame = frame_trace_frame;
+                continue;
+            }
+            words.last_frame = frame_trace_frame;
+            u32 changed_stable = 0;
+            u32 longest = 0;
+            for (size_t i = 0; i < words.data.size(); ++i) {
+                if (snapshot.data[i] == words.data[i]) {
+                    ++words.stable[i];
+                    continue;
+                }
+                if (words.stable[i] >= 64) {
+                    ++changed_stable;
+                    longest = (std::max)(longest, words.stable[i]);
+                }
+                words.stable[i] = 0;
+            }
+            if (changed_stable != 0 && logged < 24 && frame_trace_event_total < 200000) {
+                ++logged;
+                ++frame_trace_event_total;
+                LOG_INFO(HW_GPU,
+                         "Frame trace {} constants: {:#x}#{} draw {} {} {} at {:#x} size {:#x}: {} "
+                         "words stable up to {} frames changed. old {:08x} new {:08x}",
+                         frame_trace_frame, run.color, occurrence, snapshot.draw,
+                         snapshot.stage == 255 ? "vertex stream" : (snapshot.stage == 0 ? "vs cbuf" : "fs cbuf"),
+                         snapshot.slot, snapshot.address, snapshot.size, changed_stable, longest,
+                         fmt::join(words.data, " "), fmt::join(snapshot.data, " "));
+            }
+            words.data = snapshot.data;
+        }
+    }
+}
+
+template <class P>
+void TextureCache<P>::FrameTraceViewport(std::array<float, 4> recorded, std::array<float, 4> registers) {
+    if (frame_trace_runs.empty()) {
+        return;
+    }
+    FrameTraceRun& run = frame_trace_runs.back();
+    if (run.draws == 1) {
+        run.viewport = recorded;
+    }
+    if (run.width == 0 || !run.big) {
+        return;
+    }
+    const bool huge = std::abs(recorded[2]) > 1.5f * static_cast<float>(run.width) ||
+                      std::abs(recorded[3]) > 1.5f * static_cast<float>(run.height);
+    bool stale = false;
+    for (size_t i = 0; i < 4; ++i) {
+        stale |= std::abs(recorded[i] - registers[i]) > 0.5f;
+    }
+    if (!huge && !stale) {
+        return;
+    }
+    ++run.odd_viewports;
+    ++frame_trace_odd_viewports;
+    if (frame_trace_events < 16 && frame_trace_event_total < 200000) {
+        ++frame_trace_events;
+        ++frame_trace_event_total;
+        LOG_INFO(HW_GPU,
+                 "Frame trace {}: {} viewport in pass {:#x}/{:#x} {}x{} draw {}: recorded ({}, {}, {}, {}) "
+                 "registers ({}, {}, {}, {})",
+                 frame_trace_frame, stale ? "stale" : "huge", run.color, run.depth, run.width,
+                 run.height, run.draws, recorded[0], recorded[1], recorded[2], recorded[3],
+                 registers[0], registers[1], registers[2], registers[3]);
+    }
+}
+
+template <class P>
+bool TextureCache<P>::FrameDumpEnabled() {
+    static const bool enabled = std::getenv("EDEN_NX2_FRAME_DUMP") != nullptr;
+    return enabled;
+}
+
+template <class P>
+void TextureCache<P>::FrameDumpRecord(const FrameTraceRun& run, std::span<const ImageViewInOut> views) {
+    const size_t slot = frame_trace_frame % frame_dump_ring.size();
+    if (frame_dump_ring_frame[slot] != frame_trace_frame) {
+        frame_dump_ring_frame[slot] = frame_trace_frame;
+        frame_dump_ring[slot].clear();
+        frame_dump_runs[slot].clear();
+    }
+    const auto& regs = maxwell3d->regs;
+    if (run.draws == 1 && (run.depth != 0 || run.width >= 2560)) {
+        FrameTraceRunRecord& rr = frame_dump_runs[slot].emplace_back();
+        rr.run = static_cast<u32>(frame_trace_runs.size() - 1);
+        rr.color = run.color;
+        rr.depth = run.depth;
+        rr.vs = (u64{regs.pipelines[1].reserved[0] & 0xff} << 32) | regs.pipelines[1].reserved[1];
+        rr.ps = (u64{regs.pipelines[5].reserved[0] & 0xff} << 32) | regs.pipelines[5].reserved[1];
+        const auto& vt = regs.viewport_transform[0];
+        rr.viewport = {vt.scale_x, vt.scale_y, vt.scale_z, vt.translate_x, vt.translate_y, vt.translate_z};
+        rr.depth_state = {regs.depth_test_enable, regs.depth_write_enabled,
+                          static_cast<u32>(regs.depth_test_func), static_cast<u32>(regs.depth_mode)};
+        const auto& stage_buffers = maxwell3d->state.shader_stages[0].const_buffers;
+        for (u32 i = 0; i < rr.address.size() && i < stage_buffers.size(); ++i) {
+            const auto& buffer = stage_buffers[i];
+            rr.address[i] = buffer.enabled ? buffer.address : 0;
+            rr.size[i] = buffer.enabled ? buffer.size : 0;
+            rr.data[i].fill(0.0f);
+            const size_t bytes = (std::min<size_t>)(rr.size[i], sizeof(rr.data[i]));
+            if (rr.address[i] != 0 && bytes != 0 && gpu_memory->IsFullyMappedRange(rr.address[i], bytes)) {
+                gpu_memory->ReadBlockUnsafe(rr.address[i], rr.data[i].data(), bytes);
+            }
+        }
+        // EDEN_NX2_PASS_LOG=1: log the main passes' first draw every frame (driver buffer 0 as
+        // words, buffers 3 and 4 as floats) to check frames found broken afterwards.
+        static const bool pass_log = std::getenv("EDEN_NX2_PASS_LOG") != nullptr;
+        if (pass_log && run.depth != 0 && run.width >= 2560) {
+            std::array<u32, 16> c0{};
+            std::memcpy(c0.data(), rr.data[0].data(), sizeof(c0));
+            LOG_INFO(HW_GPU, "Pass log {} pass {} {:#x}/{:#x} vs {:#x} viewport [{:.4g}] depth {} c0 {:08x} c3@{:#x} [{:.4g}] c4@{:#x} [{:.4g}]",
+                     frame_trace_frame, rr.run, rr.color, rr.depth, rr.vs, fmt::join(rr.viewport, " "),
+                     fmt::join(rr.depth_state, " "), fmt::join(c0, " "), rr.address[3],
+                     fmt::join(rr.data[3], " "), rr.address[4], fmt::join(rr.data[4], " "));
+        }
+    }
+    FrameTraceDrawRecord& record = frame_dump_ring[slot].emplace_back();
+    record.run = static_cast<u32>(frame_trace_runs.size() - 1);
+    record.draw = run.draws;
+    record.color = run.color;
+    record.vs = (u64{regs.pipelines[1].reserved[0] & 0xff} << 32) | regs.pipelines[1].reserved[1];
+    record.ps = (u64{regs.pipelines[5].reserved[0] & 0xff} << 32) | regs.pipelines[5].reserved[1];
+    const auto& buffers = maxwell3d->state.shader_stages[0].const_buffers;
+    for (u32 i = 0; i < 3; ++i) {
+        const auto& buffer = buffers[4 + i];
+        record.cbuf_address[i] = buffer.enabled ? buffer.address : 0;
+        record.cbuf[i].fill(0.0f);
+        const size_t bytes = (std::min<size_t>)(buffer.size, sizeof(record.cbuf[i]));
+        if (buffer.enabled && bytes != 0 && gpu_memory->IsFullyMappedRange(buffer.address, bytes)) {
+            gpu_memory->ReadBlockUnsafe(buffer.address, record.cbuf[i].data(), bytes);
+        }
+    }
+    record.vertex = regs.vertex_streams[0].IsEnabled() ? regs.vertex_streams[0].Address() : 0;
+    {
+        const auto& ds = maxwell3d->draw_manager.draw_state;
+        record.index_address = ds.draw_indexed ? ds.index_buffer.StartAddress() : 0;
+        record.params = {static_cast<u32>(ds.topology), ds.draw_indexed ? 1u : 0u,
+                         static_cast<u32>(ds.index_buffer.format), ds.index_buffer.first,
+                         ds.index_buffer.count, ds.vertex_buffer.first, ds.vertex_buffer.count,
+                         ds.base_index, ds.base_instance, ds.instance_count,
+                         regs.vertex_streams[0].stride.Value(), regs.vertex_streams[1].stride.Value()};
+        u64 hash = 0xcbf29ce484222325ULL;
+        for (const auto& attribute : regs.vertex_attrib_format) {
+            u32 raw;
+            std::memcpy(&raw, &attribute, sizeof(raw));
+            hash = (hash ^ raw) * 0x100000001b3ULL;
+        }
+        record.attributes = hash;
+    }
+    record.textures = {};
+    size_t textures = 0;
+    for (const ImageViewInOut& view : views) {
+        if (view.id && textures < record.textures.size()) {
+            record.textures[textures++] = slot_image_views[view.id].gpu_addr;
+        }
+    }
+}
+
+// Logs the draws of `frame` whose camera/object constants differ most from the matching draw
+// (same pass, shaders and occurrence) of the frame before, and the draws with no match.
+template <class P>
+void TextureCache<P>::FrameDumpCompare(u64 frame) {
+    const size_t slot = frame % frame_dump_ring.size();
+    const size_t prev_slot = (frame - 1) % frame_dump_ring.size();
+    if (frame == 0 || frame_dump_ring_frame[slot] != frame || frame_dump_ring_frame[prev_slot] != frame - 1) {
+        LOG_INFO(HW_GPU, "Frame dump {}: not in the ring", frame);
+        return;
+    }
+    // The same object in both frames: same pass, shaders and vertex/index buffers.
+    using Key = std::tuple<u32, u64, u64, GPUVAddr, GPUVAddr>;
+    const auto key_of = [](const FrameTraceDrawRecord& r, std::map<Key, u32>& seen) {
+        const Key key{r.run, r.vs, r.ps, r.vertex, r.index_address};
+        const u32 occurrence = seen[key]++;
+        return std::make_tuple(r.run, r.vs, r.ps, r.vertex, r.index_address, occurrence);
+    };
+    std::map<std::tuple<u32, u64, u64, GPUVAddr, GPUVAddr, u32>, const FrameTraceDrawRecord*> previous;
+    std::map<Key, u32> seen;
+    for (const auto& record : frame_dump_ring[prev_slot]) {
+        previous.emplace(key_of(record, seen), &record);
+    }
+    seen.clear();
+    std::vector<std::pair<f32, const FrameTraceDrawRecord*>> scored;
+    std::vector<const FrameTraceDrawRecord*> unmatched;
+    std::vector<const FrameTraceDrawRecord*> matches;
+    for (const auto& record : frame_dump_ring[slot]) {
+        const auto it = previous.find(key_of(record, seen));
+        if (it == previous.end()) {
+            unmatched.push_back(&record);
+            continue;
+        }
+        // Changed draw parameters or vertex formats outweigh any constant change.
+        f32 score = (record.params != it->second->params || record.attributes != it->second->attributes)
+                        ? 100.0f
+                        : 0.0f;
+        for (size_t m = 0; m < 3; ++m) {
+            for (size_t i = 0; i < 12; ++i) {
+                const f32 a = record.cbuf[m][i], b = it->second->cbuf[m][i];
+                if (std::isnan(a) != std::isnan(b)) {
+                    score = (std::max)(score, 10.0f);
+                } else if (!std::isnan(a)) {
+                    score = (std::max)(score, std::abs(a - b) / (std::abs(a) + std::abs(b) + 1.0f));
+                }
+            }
+        }
+        scored.emplace_back(score, &record);
+        matches.push_back(it->second);
+    }
+    std::vector<size_t> order(scored.size());
+    std::iota(order.begin(), order.end(), size_t{0});
+    std::sort(order.begin(), order.end(), [&](size_t a, size_t b) { return scored[a].first > scored[b].first; });
+    LOG_INFO(HW_GPU, "Frame dump {}: {} draws, {} matched in frame {}, {} unmatched", frame,
+             frame_dump_ring[slot].size(), scored.size(), frame - 1, unmatched.size());
+    const auto describe = [](const FrameTraceDrawRecord& r) {
+        return fmt::format("params [{}] attr {:016x} index {:#x} vertex {:#x} tex {:#x} {:#x} vc5 [{:.4g}] vc6 [{:.4g}]",
+                           fmt::join(r.params, " "), r.attributes, r.index_address, r.vertex,
+                           r.textures[0], r.textures[1], fmt::join(r.cbuf[1], " "),
+                           fmt::join(r.cbuf[2], " "));
+    };
+    for (const FrameTraceRunRecord& rr : frame_dump_runs[slot]) {
+        std::string text;
+        for (size_t i = 0; i < rr.address.size(); ++i) {
+            if (rr.address[i] != 0) {
+                text += fmt::format(" c{}@{:#x}/{:#x}[{:.4g}]", i, rr.address[i], rr.size[i],
+                                    fmt::join(rr.data[i], " "));
+            }
+        }
+        LOG_INFO(HW_GPU, "Frame dump {} pass {} {:#x}/{:#x} vs {:#x} ps {:#x} viewport [{:.4g}] depth {}:{}",
+                 frame, rr.run, rr.color, rr.depth, rr.vs, rr.ps, fmt::join(rr.viewport, " "),
+                 fmt::join(rr.depth_state, " "), text);
+    }
+    for (size_t n = 0; n < (std::min<size_t>)(8, order.size()); ++n) {
+        const auto& [score, record] = scored[order[n]];
+        const FrameTraceDrawRecord& before = *matches[order[n]];
+        LOG_INFO(HW_GPU, "Frame dump {} #{}: score {:.3g} pass {} {:#x} draw {} vs {:#x} ps {:#x}: now {} | before {}",
+                 frame, n, score, record->run, record->color, record->draw, record->vs, record->ps,
+                 describe(*record), describe(before));
+    }
+    for (size_t n = 0; n < (std::min<size_t>)(16, unmatched.size()); ++n) {
+        const FrameTraceDrawRecord& record = *unmatched[n];
+        LOG_INFO(HW_GPU, "Frame dump {} new: pass {} {:#x} draw {} vs {:#x} ps {:#x}: {}", frame,
+                 record.run, record.color, record.draw, record.vs, record.ps, describe(record));
+    }
+}
+
+template <class P>
+void TextureCache<P>::FrameTraceClear() {
+    FrameTraceDraw({}, false);
+    --frame_trace_runs.back().draws;
+    --frame_trace_draws;
+    ++frame_trace_runs.back().clears;
+}
+
+template <class P>
+void TextureCache<P>::FrameTraceSkip(bool no_pipeline) {
+    ++(no_pipeline ? frame_trace_skip_pipeline : frame_trace_skip_configure);
+}
+
+template <class P>
+void TextureCache<P>::FrameTraceTick() {
+    u64 signature = 0xcbf29ce484222325ULL;
+    const auto mix = [&](u64 value) { signature = (signature ^ value) * 0x100000001b3ULL; };
+    size_t big = 0;
+    for (const FrameTraceRun& run : frame_trace_runs) {
+        if (!run.big) {
+            continue;
+        }
+        ++big;
+        mix(run.color);
+        mix(run.depth);
+        mix(u64{run.width} | u64{run.height} << 20 | u64{run.format} << 40 | u64{run.compute} << 63);
+        if (run.overflow) {
+            mix(1);
+            continue;
+        }
+        for (const auto& texture : run.textures) {
+            mix(texture.first);
+        }
+    }
+    FrameTraceCompare();
+    if (FrameDumpEnabled()) {
+        const u64 request = g_nx2_frame_dump_request.load(std::memory_order_relaxed);
+        // Trace frame = present - 1; wait until that frame is complete (this tick ends it).
+        if (request != 0 && request != frame_dump_done && frame_trace_frame + 1 >= request) {
+            frame_dump_done = request;
+            LOG_INFO(HW_GPU, "Frame dump requested for present {} (now at trace frame {})", request,
+                     frame_trace_frame);
+            for (u64 frame = request - 4; frame + 1 <= request; ++frame) {
+                FrameDumpCompare(frame);
+            }
+        }
+    }
+    const bool is_new = std::ranges::find(frame_trace_recent, signature) == frame_trace_recent.end();
+    frame_trace_recent.push_back(signature);
+    if (frame_trace_recent.size() > 120) {
+        frame_trace_recent.pop_front();
+    }
+    const auto delta = [](u64 now, u64& base) {
+        const u64 value = now >= base ? now - base : now;
+        base = now;
+        return value;
+    };
+    const u64 created = delta(images_created, frame_trace_created);
+    const u64 deleted = delta(images_deleted, frame_trace_deleted);
+    const u64 uploaded = delta(images_uploaded, frame_trace_uploaded);
+    LOG_INFO(HW_GPU,
+             "Frame trace {}: {} draws, {} passes ({} big), skipped {} no-pipeline / {} configure, "
+             "images +{} -{}, {} uploads, {} GPU-written refreshes, {} CPU writes on GPU-written "
+             "images, {} odd viewports, signature {:016x}{}",
+             frame_trace_frame, frame_trace_draws, frame_trace_runs.size(), big,
+             frame_trace_skip_pipeline, frame_trace_skip_configure, created, deleted, uploaded,
