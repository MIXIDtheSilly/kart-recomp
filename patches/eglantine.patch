-    std::memset(backing_base + physical_offset, fill_value, length);
+    if (fill_value != 0 || !freed_pages || physical_offset % BackingTrackPageSize != 0 ||
+        length % BackingTrackPageSize != 0 || physical_offset + length > backing_size) {
+        std::memset(backing_base + physical_offset, fill_value, length);
+        return;
+    }
+    // Clear runs of freed pages; never-freed pages are untouched host memory and read zero.
+    const size_t first = physical_offset / BackingTrackPageSize;
+    const size_t last = first + length / BackingTrackPageSize;
+    size_t run_start = last;
+    const auto flush = [&](size_t end) {
+        if (run_start < end) {
+            std::memset(backing_base + run_start * BackingTrackPageSize, 0,
+                        (end - run_start) * BackingTrackPageSize);
+        }
+        run_start = last;
+    };
+    for (size_t page = first; page < last; ++page) {
+        const u64 word = freed_pages[page / 64].load(std::memory_order_relaxed);
+        if ((word >> (page % 64)) & 1) {
+            if (run_start == last) {
+                run_start = page;
+            }
+        } else {
+            flush(page);
+        }
+    }
+    flush(last);
+}
