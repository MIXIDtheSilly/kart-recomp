+/// The command-line frontend has no input dialog: when player 1 is not bound to a controller,
+/// bind the first connected SDL controller with the driver's default mapping (the Qt frontend's
+/// automatic mapping).
+static void AutoMapController(InputCommon::InputSubsystem& input, Core::System& system) {
+    auto& player = Settings::values.players.GetValue()[0];
+    for (const auto& b : player.buttons) {
+        if (b.find("engine:sdl") != std::string::npos) {
+            return;  // already mapped to a controller
+        }
+    }
+    // Controllers are reported by the SDL event thread shortly after it starts.
+    std::optional<Common::ParamPackage> device;
+    for (int tries = 0; tries < 20 && !device; tries++) {
+        for (const auto& d : input.GetInputDevices()) {
+            if (d.Get("engine", "") == "sdl") {
+                device = d;
+                break;
+            }
+        }
+        if (!device) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+    }
+    if (!device) {
+        LOG_INFO(Frontend, "No controller connected, keeping the keyboard mapping for player 1");
+        return;
+    }
+    for (const auto& [button, params] : input.GetButtonMappingForDevice(*device)) {
+        player.buttons[button] = params.Serialize();
+    }
+    for (const auto& [analog, params] : input.GetAnalogMappingForDevice(*device)) {
+        player.analogs[analog] = params.Serialize();
+    }
+    for (const auto& [motion, params] : input.GetMotionMappingForDevice(*device)) {
+        player.motions[motion] = params.Serialize();
+    }
+    player.controller_type = Settings::ControllerType::ProController;
+    player.connected = true;
+    system.HIDCore().ReloadInputDevices();
+    LOG_INFO(Frontend, "Player 1 mapped to controller \"{}\"", device->Get("display", "?"));
+}
