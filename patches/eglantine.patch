+template <class P>
+std::pair<u64, u64> BufferCache<P>::LostCheckRange() {
+    static const std::pair<u64, u64> range = [] {
+        const char* v = std::getenv("EDEN_NX2_LOST_CHECK");
+        if (v == nullptr) {
+            return std::pair<u64, u64>{0, 0};
+        }
+        char* end = nullptr;
+        const u64 lo = std::strtoull(v, &end, 16);
+        const u64 hi = end != nullptr && *end == '-' ? std::strtoull(end + 1, nullptr, 16) : 0;
+        return std::pair<u64, u64>{lo, hi};
+    }();
+    return range;
+}
+
+template <class P>
+void BufferCache<P>::LostSnapshot(DAddr device_addr, u64 size) {
+    const auto [lo, hi] = LostCheckRange();
+    DAddr begin = (std::max<u64>)(device_addr, lo);
+    const DAddr end = (std::min<u64>)(device_addr + size, hi);
+    if (begin >= end) {
+        return;
+    }
+    lost_scratch.resize(end - begin);
+    device_memory.ReadBlockUnsafe(begin, lost_scratch.data(), end - begin);
+    const u8* data = lost_scratch.data();
+    while (begin < end) {
+        const size_t offset = begin & 4095;
+        const size_t chunk = (std::min<u64>)(end - begin, 4096 - offset);
+        auto& slot = lost_snapshot[begin >> 12];
+        if (!slot) {
+            slot = std::make_unique<UniformMirrorPage>();
+            slot->valid.fill(0);
+        }
+        std::memcpy(slot->data.data() + offset, data, chunk);
+        uniform_check::SetValid(slot->valid, offset, offset + chunk, true);
+        if (const auto it = lost_notified.find(begin >> 12); it != lost_notified.end()) {
+            uniform_check::SetValid(it->second->valid, offset, offset + chunk, false);
+        }
+        begin += chunk;
+        data += chunk;
+    }
+}
+
+template <class P>
+void BufferCache<P>::LostNotified(DAddr device_addr, u64 size) {
+    const auto [lo, hi] = LostCheckRange();
+    DAddr begin = (std::max<u64>)(device_addr, lo);
+    const DAddr end = (std::min<u64>)(device_addr + size, hi);
+    while (begin < end) {
+        const size_t offset = begin & 4095;
+        const size_t chunk = (std::min<u64>)(end - begin, 4096 - offset);
+        auto& slot = lost_notified[begin >> 12];
+        if (!slot) {
+            slot = std::make_unique<UniformMirrorPage>();
+            slot->valid.fill(0);
+        }
+        uniform_check::SetValid(slot->valid, offset, offset + chunk, true);
+        begin += chunk;
+    }
+}
+
+template <class P>
+void BufferCache<P>::LostCheck(u32 index, DAddr device_addr, u32 size) {
+    const auto [lo, hi] = LostCheckRange();
+    if (size == 0 || device_addr >= hi || device_addr + size <= lo) {
+        return;
+    }
+    ++lost_binds;
+    u32 bad = 0;
+    DAddr first_bad = 0;
+    std::array<u32, 2> guest_words{};
+    std::array<u32, 2> snapshot_words{};
+    std::array<u8, 4096> guest{};
+    gpu_modified_ranges.ForEachInRange(device_addr, size, [&](DAddr range_begin, DAddr range_end) {
+        DAddr addr = (std::max)(range_begin, device_addr);
+        const DAddr end = (std::min<DAddr>)(range_end, device_addr + size);
+        while (addr < end) {
+            const size_t offset = addr & 4095;
+            const size_t chunk = (std::min<u64>)(end - addr, 4096 - offset);
+            const auto it = lost_snapshot.find(addr >> 12);
+            if (it != lost_snapshot.end()) {
+                device_memory.ReadBlockUnsafe(addr, guest.data(), chunk);
+                const UniformMirrorPage& page = *it->second;
+                for (size_t i = 0; i < chunk; ++i) {
+                    const size_t at = offset + i;
+                    if (((page.valid[at / 64] >> (at % 64)) & 1) == 0 || page.data[at] == guest[i]) {
+                        continue;
+                    }
+                    if (const auto n = lost_notified.find(addr >> 12);
+                        n != lost_notified.end() && ((n->second->valid[at / 64] >> (at % 64)) & 1) != 0) {
+                        ++lost_bad_notified;
+                    }
+                    if (bad++ == 0) {
+                        first_bad = addr + i;
+                        const size_t word = at & ~size_t{7};
+                        if (word >= offset && word + 8 <= offset + chunk) {
+                            std::memcpy(guest_words.data(), guest.data() + (word - offset), 8);
+                            std::memcpy(snapshot_words.data(), page.data.data() + word, 8);
+                        }
+                    }
+                }
+            }
+            addr += chunk;
+        }
+    });
+    if (bad == 0) {
+        return;
+    }
+    ++lost_bad_binds;
+    lost_bad_bytes += bad;
+    if (lost_logged++ < 300) {
+        const auto [backing_va, backing_state] = device_memory.DebugCpuBacking(first_bad);
+        const int page_state = g_nx2_debug_page_state ? g_nx2_debug_page_state(backing_va) : -1;
+        LOG_INFO(HW_GPU,
+                 "Lost check frame {}: stream {} [{:#x}, +{:#x}): {} GPU-written bytes changed in guest "
+                 "memory since the GPU wrote them (first {:#x}: guest {:08x} {:08x}, then {:08x} {:08x}); "
+                 "CPU-modified {}, CPU backing {:#x}, page state {:#x}",
+                 lost_frame, index, device_addr, size, bad, first_bad, guest_words[0],
+                 guest_words[1], snapshot_words[0], snapshot_words[1],
+                 memory_tracker.IsRegionCpuModified(first_bad & ~DAddr{4095}, 4096), backing_va, page_state);
+    }
+}
+
+template <class P>
+void BufferCache<P>::MirrorWrite(DAddr device_addr, const u8* data, size_t size) {
+    if (!UniformCheckEnabled() && !InstanceCheckEnabled()) {
+        return;
+    }
+    while (size != 0) {
+        const size_t offset = device_addr & 4095;
+        const size_t chunk = (std::min)(size, 4096 - offset);
+        if (const auto it = uniform_mirror.find(device_addr >> 12); it != uniform_mirror.end()) {
+            std::memcpy(it->second->data.data() + offset, data, chunk);
+            uniform_check::SetValid(it->second->valid, offset, offset + chunk, true);
+        }
+        device_addr += chunk;
+        data += chunk;
+        size -= chunk;
+    }
+}
+
+template <class P>
+void BufferCache<P>::MirrorInvalidate(DAddr device_addr, size_t size) {
+    if (!UniformCheckEnabled() && !InstanceCheckEnabled()) {
+        return;
+    }
+    while (size != 0) {
+        const size_t offset = device_addr & 4095;
+        const size_t chunk = (std::min)(size, 4096 - offset);
+        if (const auto it = uniform_mirror.find(device_addr >> 12); it != uniform_mirror.end()) {
+            uniform_check::SetValid(it->second->valid, offset, offset + chunk, false);
+        }
+        device_addr += chunk;
+        size -= chunk;
+    }
+}
+
+template <class P>
+void BufferCache<P>::MirrorCheck(size_t stage, u32 index, DAddr device_addr, u32 size,
+                                 bool uploaded) {
+    if (size == 0) {
+        return;
+    }
+    if (FullCheckEnabled() && size > 0x4000 &&
+        !uniform_check_seen.insert(device_addr ^ (u64{size} << 40) ^ (u64{stage} << 56)).second) {
+        return;
+    }
+    ++uniform_check_binds;
+    const bool gpu_written = gpu_modified_ranges.Intersects(device_addr, size);
+    uniform_check_gpu_binds += gpu_written ? 1 : 0;
+    uniform_check_scratch.resize(size);
+    device_memory.ReadBlockUnsafe(device_addr, uniform_check_scratch.data(), size);
+    u32 bad = 0;
+    u32 first_bad = ~0U;
+    for (DAddr addr = device_addr, end = device_addr + size; addr < end;) {
+        const size_t offset = addr & 4095;
+        const size_t chunk = (std::min<u64>)(end - addr, 4096 - offset);
+        const u8* const guest = uniform_check_scratch.data() + (addr - device_addr);
+        auto& slot = uniform_mirror[addr >> 12];
+        if (!slot) {
+            // First bind of this page: the buffer was just synchronized, take guest memory as
+            // what it holds.
+            slot = std::make_unique<UniformMirrorPage>();
+            slot->valid.fill(0);
+            std::memcpy(slot->data.data() + offset, guest, chunk);
+            if (!gpu_written) {
+                uniform_check::SetValid(slot->valid, offset, offset + chunk, true);
+            }
+        } else {
+            const u8* const mirror = slot->data.data();
+            for (size_t i = offset; i < offset + chunk;) {
+                if (i % 64 == 0 && i + 64 <= offset + chunk && slot->valid[i / 64] == ~0ULL &&
+                    std::memcmp(mirror + i, guest + (i - offset), 64) == 0) {
+                    i += 64;
+                    continue;
+                }
+                const size_t stop = (std::min)(offset + chunk, (i / 64 + 1) * 64);
+                for (; i < stop; ++i) {
+                    if (((slot->valid[i / 64] >> (i % 64)) & 1) != 0 &&
+                        mirror[i] != guest[i - offset]) {
+                        ++bad;
+                        first_bad = (std::min)(first_bad, static_cast<u32>(addr - device_addr + i - offset));
+                    }
+                }
+            }
+        }
+        addr += chunk;
+    }
+    if (bad == 0) {
+        return;
+    }
+    ++uniform_check_bad_binds;
+    uniform_check_bad_bytes += bad;
+    ++uniform_check_bad_kind[stage == 255   ? 1
+                             : stage == 254 || stage == 252 ? 2
+                             : stage == 253 ? 3
+                             : stage >= 130 ? 6
+                             : stage >= 120 ? 5
+                             : stage >= 100 ? 4
+                                            : 0];
+    if (++uniform_check_logged > 400 && uniform_check_logged % 1000 != 0) {
+        return;
+    }
+    const u32 at = first_bad & ~15U;
+    std::array<u32, 4> guest_words{};
+    std::array<u32, 4> mirror_words{};
+    std::memcpy(guest_words.data(), uniform_check_scratch.data() + at,
+                (std::min<u32>)(16, size - at));
+    const DAddr word_addr = device_addr + at;
+    if (const auto it = uniform_mirror.find(word_addr >> 12); it != uniform_mirror.end()) {
+        std::memcpy(mirror_words.data(), it->second->data.data() + (word_addr & 4095),
+                    (std::min<u64>)(16, 4096 - (word_addr & 4095)));
+    }
+    const auto [backing_va, backing_state] = device_memory.DebugCpuBacking(word_addr);
+    // The embedding host's view of that page: protection (low byte), GPU-cached (0x1000),
+    // read-trapped (0x2000); -1 without a host hook.
+    const int page_state = g_nx2_debug_page_state ? g_nx2_debug_page_state(backing_va) : -1;
+    const auto [reverse_pages, reverse_found] = device_memory.DebugReverse(word_addr);
+    LOG_INFO(HW_GPU,
+             "Uniform check frame {}: stage {} cbuf {} [{:#x}, +{:#x}) {} of its bytes differ "
+             "from guest memory (first at +{:#x}), uploaded {}, GPU-written {} (tracker {}), CPU-modified {}; "
+             "guest {:08x} {:08x} {:08x} {:08x}, GPU copy {:08x} {:08x} {:08x} {:08x}; "
+             "CPU backing {:#x} ({}), page state {:#x}, CPU writes reach device pages [{:#x}]{}",
+             uniform_check_frame, stage, index, device_addr, size, bad, first_bad, uploaded,
+             gpu_written, memory_tracker.IsRegionGpuModified(device_addr, size),
+             memory_tracker.IsRegionCpuModified(device_addr, size), guest_words[0],
+             guest_words[1], guest_words[2], guest_words[3], mirror_words[0], mirror_words[1],
+             mirror_words[2], mirror_words[3], backing_va,
+             backing_state == 1 ? "maps here" : (backing_state == 0 ? "maps OTHER memory" : "unmapped"),
+             page_state, fmt::join(reverse_pages, " "), reverse_found ? "" : " (NOT this one)");
+}
