+    if constexpr (requires { image.LayerHasMemory(0); }) {
+        if (image.discards_layers) {
+            range.whole_layers.resize(image.info.resources.layers);
+            for (u32 layer = 0; layer < range.whole_layers.size(); ++layer) {
+                range.whole_layers[layer] = !image.LayerHasMemory(layer);
