+namespace uniform_check {
+inline void SetValid(std::array<u64, 64>& valid, size_t begin, size_t end, bool on) {
+    for (size_t i = begin; i < end;) {
+        const size_t bit = i % 64;
+        const size_t count = (std::min)(end - i, 64 - bit);
+        const u64 mask = count == 64 ? ~0ULL : ((1ULL << count) - 1) << bit;
+        valid[i / 64] = on ? (valid[i / 64] | mask) : (valid[i / 64] & ~mask);
+        i += count;
+    }
+}
