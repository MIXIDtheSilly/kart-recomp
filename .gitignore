# Generated from the game or built from it: stays local.
/build/
/gen/
/out/
/work/
/host/out/
/ver/

# Editor and Python leftovers
__pycache__/
*.pyc
.vs/
.vscode/

# Built by launcher/build.bat and tools/texbake/build.bat
/launcher/out/
/tools/texbake/*.exe
/tools/texbake/*.obj

# Dependencies fetched and built by tools/setup_deps.py, and local paths (tools/paths.py)
/deps/
/local.cfg

# Built by dotnet (tools/nvn_shaders.py builds the shader translator into work/xlate)
/tools/xlate/**/bin/
/tools/xlate/**/obj/
