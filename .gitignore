# Generated from the game or built from it: stays local.
/build/
/gen/
/out/
/work/
/host/out/
/ver/

# Editor and Python leftovers
__pycache__/
*.pyc
.vs/
.vscode/

# Built by launcher/build.bat and tools/texbake/build.bat
/launcher/out/
/tools/texbake/*.exe
/tools/texbake/*.obj

# Local paths and settings (tools/paths.py); deps/ held the external dependencies before third_party/
/deps/
/local.cfg

# What the launcher's Set up downloads: the C++ toolchain (tools/toolchain.py), Python and the .NET SDK when missing (tools/bootstrap.ps1)
/tools/llvm-mingw/
/tools/python/
/tools/dotnet/
/tools/llvm-mingw.tmp/
/tools/llvm-mingw-*.zip

# Built by dotnet (tools/nvn_shaders.py builds the shader translator into work/xlate)
/tools/xlate/**/bin/
/tools/xlate/**/obj/
